<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- Amethyst application identifier -->
    <key>application-identifier</key>
    <string>org.angelauramc.amethyst</string>

    <!-- Required container -->
    <key>com.apple.private.security.container-required</key>
    <string>org.angelauramc.amethyst</string>

    <!-- Required by StikDebug for JIT -->
    <key>get-task-allow</key>
    <true/>

    <!-- Extended virtual addressing -->
    <key>com.apple.developer.kernel.extended-virtual-addressing</key>
    <true/>

    <!-- Increased memory limit -->
    <key>com.apple.developer.kernel.increased-memory-limit</key>
    <true/>

    <!-- Allow memory-status related operations -->
    <key>com.apple.private.memorystatus</key>
    <true/>

    <!-- Custom trust entitlement -->
    <key>jb.pmap_cs.custom_trust</key>
    <string>PMAP_CS_APP_STORE</string>

</dict>
</plist>
